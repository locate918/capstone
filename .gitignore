# Paste just the clean content:
Set-Content -Path .gitignore -Value @"
# Rust
target/


# Node/React
node_modules/
dist/
build/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Database
*.db
*.sqlite

# Secrets
.env
.env.dev
*.pem
*.key
**/.env

# Backup files
*.bak

# Scraped data output
backend/src/scraper/scraped_data/
# Runtime venue-resolution triage log (regenerated each scrape)
backend/src/scraper/unresolved_venues.json

# Data exports and database dumps
*.csv
locate918_backup.sql

# Python
__pycache__/
*.pyc
.venv/
venv/
"@. e n v 
 
 # Visual Studio cache/options directory
.vs/

# Other common ignores
node_modules/
build/
dist/
.env
*.log

# Claude Code
.claude/
